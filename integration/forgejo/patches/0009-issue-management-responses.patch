+
+// issueManagementRedirect preserves native validation failures in the SPA's
+// explicit response mode, rather than treating a flash-error redirect as success.
+func issueManagementRedirect(ctx *context.Context, jsonRedirect bool, location string, status ...int) {
+	if ctx.Req.Header.Get("X-Forgejo-UI") == "1" && (ctx.HasError() || ctx.Flash.ErrorMsg != "") {
+		message := ctx.Flash.ErrorMsg
+		if message == "" { message = ctx.GetErrMsg() }
+		ctx.JSON(http.StatusUnprocessableEntity, map[string]string{"errorMessage": message})
+		return
+	}
+	if jsonRedirect { ctx.JSONRedirect(location); return }
+	ctx.Redirect(location, status...)
+}
